# CI matrix image: proves the appliance toolchain runs on musl/Alpine, not
# just glibc Debian. Throwaway verification target only — not production.
FROM node:20-alpine AS deps
RUN apk add --no-cache python3 make g++ bash
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM deps
COPY . .
CMD ["sh", "-c", "npm run typecheck && npm test && npm run build"]
