{
  "name": "cv-auto",
  "version": "1.0.0",
  "description": "Self-deploying local WhatsApp CV automation appliance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cv-auto": "./dist/cli/cv-auto.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx api/index.ts",
    "dev:worker": "tsx worker/index.ts",
    "cli": "tsx cli/cv-auto.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "better-sqlite3": "^11.3.0",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "googleapis": "^144.0.0",
    "ioredis": "^5.11.1",
    "openai": "^4.67.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "yargs": "^17.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/yargs": "^17.0.33",
    "nock": "^14.0.0-beta.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
