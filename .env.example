# CV automation environment overrides. Real values are written by the setup
# wizard into config/config.json (chmod 0600). This file is for reference and
# container-only deployments. Never commit real values.

# --- General ---
CV_DEVICE_NAME=CV-AUTO-01
CV_CONFIG_DIR=/data/config
CV_DATA_DIR=/data/data
CV_LOG_DIR=/data/logs
CV_API_PORT=3000
CV_REDIS_URL=redis://redis:6379
CV_SESSION_TIMEOUT_MINUTES=30
CV_LOG_LEVEL=info
CV_LOG_PRETTY=0

# --- WhatsApp Business Cloud API ---
CV_WHATSAPP_TOKEN=
CV_WHATSAPP_PHONE_ID=
CV_WHATSAPP_WABA_ID=
CV_WHATSAPP_VERIFY_TOKEN=
CV_WHATSAPP_APP_SECRET=
CV_WHATSAPP_API_VERSION=v21.0

# --- OpenRouter ---
CV_OPENROUTER_KEY=
CV_OPENROUTER_MODEL=google/gemini-3.8-flash

# --- Google Sheets (service account) ---
CV_SHEET_ID=
CV_SHEETS_SERVICE_ACCOUNT_EMAIL=
CV_SHEETS_PRIVATE_KEY=

# --- OneDrive (Microsoft Graph, public client) ---
CV_ONEDRIVE_CLIENT_ID=
CV_ONEDRIVE_TENANT=consumers
CV_ONEDRIVE_FOLDER=CV Applications

# --- Admin ---
CV_ADMIN_NUMBER=
CV_DASHBOARD_URL=

# --- Private management API / dashboard (separate runtime, loopback-only) ---
# CV_ADMIN_TOKEN is REQUIRED (random, >=24 chars, >=8 unique characters); the
# admin runtime fails closed without it. Generate with: openssl rand -base64 32
# The setup wizard generates and stores one in data/cv-auto/admin-token.
CV_ADMIN_TOKEN=
CV_ADMIN_PORT=3001
# Containers bind 0.0.0.0 inside the container namespace; the compose port
# publishing keeps the host side on 127.0.0.1. Leave unset outside Docker.
CV_ADMIN_HOST=
